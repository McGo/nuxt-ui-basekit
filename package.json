{
  "name": "nuxt-ui-basekit",
  "version": "0.1.0",
  "description": "Markenfreie Basis-Komponenten für Nuxt 4 auf Nuxt UI — Tabellen, Reiter, Diagramme, Auswahl und Leerzustände als Nuxt-Layer.",
  "keywords": [
    "nuxt",
    "nuxt-layer",
    "nuxt-ui",
    "vue",
    "components",
    "charts",
    "data-table"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./nuxt.config.ts",
  "files": [
    "app",
    "nuxt.config.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./nuxt.config.ts",
      "import": "./nuxt.config.ts"
    },
    "./labels": "./app/composables/useBaseKit.ts",
    "./app/*.vue": "./app/*.vue",
    "./app/*.css": "./app/*.css",
    "./app/*": "./app/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev:prepare": "nuxi prepare",
    "lint": "nuxi typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@nuxt/ui": "^4.0.0",
    "nuxt": "^4.0.0",
    "pinia": "^2.2.0 || ^3.0.0 || ^4.0.0"
  },
  "dependencies": {
    "@tiptap/extension-link": "^3.27.0",
    "@tiptap/pm": "^3.27.0",
    "@tiptap/starter-kit": "^3.27.0",
    "@tiptap/vue-3": "^3.27.0",
    "markdown-it": "^14.2.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@nuxt/ui": "^4.7.1",
    "@types/markdown-it": "^14.1.2",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "nuxt": "^4.0.0",
    "pinia": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.6",
    "vue-tsc": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/McGo/nuxt-ui-basekit.git"
  },
  "homepage": "https://github.com/McGo/nuxt-ui-basekit#readme",
  "bugs": {
    "url": "https://github.com/McGo/nuxt-ui-basekit/issues"
  },
  "author": "Mirko Haaser <kontakt@mirko-haaser.de>",
  "license": "MIT"
}
